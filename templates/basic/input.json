    "move_down":  [{ "kind": "key", "code": "ArrowDown" },  { "kind": "key", "code": "KeyS" }, { "kind": "gamepad_axis", "axis": "LeftStickY", "direction": "negative" }, { "kind": "gamepad_button", "button": "DPadDown" }],
