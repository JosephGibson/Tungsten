                "caption": "UI scale",
                "key": "ui_scale",
                "kind": "slider_row",
                "range": {
                  "max": 2,
                  "min": 0.5,
                  "step": 0.25
                },
                "readout": "ui_scale_text"
              },
              {
                "bind": {
                  "value": "text_scale"
                },
                "caption": "Text scale",
                "key": "text_scale",
                "kind": "slider_row",
                "range": {
                  "max": 2,
                  "min": 0.5,
                  "step": 0.25
                },
                "readout": "text_scale_text"
              }
            ],
            "key": "interface_rows",
            "kind": "column",
            "layout": {
              "width": "fill"
            }
          },
          {
            "bind": {
              "visible": "controls_tab"
            },
            "children": [
              {
                "key": "keybindings",
                "kind": "button",
                "text": "Keybindings…"
              },
              {
                "key": "reset_bindings",
                "kind": "button",
                "text": "Reset all bindings"
              }
            ],
            "key": "controls_rows",
            "kind": "column",
            "layout": {
              "width": "fill"
            }
          },
          {
            "bind": {
              "visible": "gameplay_tab"
            },
            "children": [
              {
                "bind": {
                  "enabled": "in_run",
                  "text": "difficulty"
                },
                "caption": "Difficulty",
                "key": "difficulty",
                "kind": "choice_row"
              },
              {
                "bind": {
                  "value": "screen_shake"
                },
                "caption": "Screen shake",
                "key": "screen_shake",
                "kind": "slider_row",
                "range": {
                  "max": 100,
                  "min": 0,
                  "step": 5
                },
                "readout": "screen_shake_text"
              },
              {
                "bind": {
                  "value": "damage_numbers"
                },
                "caption": "Damage numbers",
                "key": "damage_numbers",
                "kind": "toggle_row"
              },
              {
                "bind": {
                  "value": "pause_unfocused"
                },
                "caption": "Pause when unfocused",
                "key": "pause_unfocused",
                "kind": "toggle_row"
              },
              {
                "bind": {
                  "value": "autosave"
                },
                "caption": "Autosave",
                "key": "autosave",
                "kind": "toggle_row"
              }
            ],
            "key": "gameplay_rows",
            "kind": "column",
            "layout": {
              "width": "fill"
            }
          }
        ],
        "kind": "row",
        "layout": {
          "align_items": "start"
        }
      },
      {
        "children": [
          {
            "key": "reset_tab",
            "kind": "button",
            "text": "Reset tab"
          },
          {
            "key": "back",
            "kind": "button",
            "text": "Back"
          }
        ],
        "kind": "row"
      }
    ],
    "kind": "screen",
    "width": "wide_width"
  },
  "version": 1
}
