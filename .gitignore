# LLM tooling local state. Only shared project settings and the project
# skills under .claude/ are tracked; personal settings, hooks and state stay local.
.aider*
.cursor/
/.claude/*
!/.claude/settings.json
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/tungsten-wgpu/
!/.claude/skills/tungsten-perf/
!/.claude/skills/tungsten-finalize/
